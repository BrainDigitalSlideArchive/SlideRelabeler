{
  "name": "slide-relabeler",
  "productName": "SlideRelabeler",
  "version": "0.9.2",
  "description": "Overwrite or delete label images from whole slide images",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "node scripts/run-with-conda.mjs npm start",
    "start": "electron-forge start",
    "debug": "node scripts/run-with-conda.mjs electron-forge start -- debug",
    "startpi": "electron-forge start -- pyinstaller debug",
    "startpib": "node scripts/run-with-conda.mjs npm run startpib:raw",
    "startpib:raw": "pyinstaller -y --clean ./pyinstaller/engine.spec && electron-forge start -- pyinstaller debug",
    "package": "node scripts/run-with-conda.mjs electron-forge package",
    "make": "node scripts/run-with-conda.mjs electron-forge make",
    "publish": "node scripts/run-with-conda.mjs electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": {
    "name": "Thomas Pearce",
    "email": "tmpearce@gmail.com"
  },
  "contributors": [
