    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-loader": "^9.2.1",
    "electron": "^40.8.0",
    "electron-devtools-installer": "^3.2.0",
    "postcss": "^8.5.8",
    "postcss-preset-env": "^10.6.1",
